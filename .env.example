# ---- Core ----
NODE_ENV=development            # development | production | test
PORT=5000
# Local MongoDB or Atlas, e.g. mongodb+srv://<user>:<password>@<cluster>/phantom_veil?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/phantom_veil
# REQUIRED in production (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public URL of the frontend (used in password-reset links)
FRONTEND_URL=http://localhost:8080
# Comma-separated allowed origins if the frontend is on another domain ("*" = any).
# Leave empty when frontend and API share a domain (Vercel / single server).
CORS_ORIGIN=

# ---- Seeding ----
# Admin is created on first boot if no admin exists (never promotes an existing account).
ADMIN_USERNAME=VeilKeeper
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Catalog + demo users (default: true in dev, false in production). Only seeds an EMPTY movie collection.
SEED_DEMO_DATA=

# ---- Movie catalog ----
# Without a TMDB credential the app serves the bundled titles + live TVmaze shows.
# With one, TMDB becomes the primary source (horror movie library). See README "Enable TMDB".
EXTERNAL_CATALOG_ENABLED=true
EXTERNAL_SYNC_TTL_HOURS=24
# Preferred: TMDB "API Read Access Token" (v4, sent as Authorization: Bearer)
TMDB_READ_TOKEN=
# Alternative: TMDB v3 API key (sent as ?api_key=)
TMDB_API_KEY=
# Region for "Where to watch" (US is the fallback) and detail-cache lifetime
TMDB_REGION=IN
TMDB_DETAILS_TTL_HOURS=168
# Secret for GET /api/cron/sync (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ---- Ops ----
RATE_LIMIT_ENABLED=true
TRUST_PROXY=1                   # number of reverse proxies in front of the app
LOG_LEVEL=info                  # debug | info | warn | error | silent
